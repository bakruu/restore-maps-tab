{
  "manifest_version": 3,
  "name": "Restore Maps Tab",
  "version": "1.0.0",
  "description": "Restores a Maps shortcut to Google Search results.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.com.tr/search*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}